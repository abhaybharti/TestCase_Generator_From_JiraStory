# OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4o-mini

# Jira Cloud site URL, without a trailing slash
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=replace_me

# Optional Jira custom field key for acceptance criteria, e.g. customfield_10016
# Find the field key in Jira issue JSON / Jira admin field configuration.
JIRA_ACCEPTANCE_CRITERIA_FIELD=

# Request timeout in seconds
HTTP_TIMEOUT_SECONDS=20
